{
  "rule_version": "claude-desktop-2026.09.21g",
  "service_key": "claude-desktop",
  "target": {
    "service": "Claude",
    "client": "desktop",
    "display": "Claude Desktop (MSIX + Electron)",
    "app_root": {
      "relative": "AppData/Local/Packages/Claude_pzs8sxrjxfjjc/LocalCache/Roaming/Claude",
      "alternatives": [
        "AppData/Roaming/Claude",
        "AppData/Local/Claude",
        "AppData/Local/Claude-Data"
      ],
      "package_dir": "Claude_pzs8sxrjxfjjc",
      "tail": "localcache/roaming/claude",
      "marker_files": [
        "config.json"
      ],
      "marker_dirs": [
        "IndexedDB"
      ],
      "note": "설치 형태에 따라 사용자 데이터 위치가 다르다. MSIX(스토어) 설치는 MSIX 가상화로 %APPDATA%\\Claude 가 존재하지 않고 패키지 컨테이너 경로를 쓴다. 일반 설치본(.exe)은 %APPDATA%\\Claude 를 쓴다. 최신 빌드는 %LOCALAPPDATA%\\Claude 에 로그를, %LOCALAPPDATA%\\Claude-Data 에 사용자 데이터를 둔다. 후보를 순서대로 모두 찾는다."
    },
    "sources": [
      "cache",
      "indexeddb",
      "localstorage",
      "blob",
      "config",
      "applog",
      "fsmeta"
    ],
    "sources_extended": [
      "usnjrnl",
      "recyclebin"
    ]
  },
  "note": "행위 판별 규칙. 코드가 아니라 이 파일을 고쳐서 갱신한다. 앱이 업데이트돼 경로·키가 바뀌면 여기만 손보면 된다. 규칙을 고치면 rule_version 도 함께 올린다 — 결과에 기록되는 값이다.",
  "categories": {
    "account": "계정",
    "install": "설치·삭제",
    "conv": "대화 관리",
    "prompt": "프롬프트",
    "file": "파일 입출력",
    "share": "공유·내보내기",
    "runtime": "실행 상태",
    "settings": "설정 변경",
    "privacy": "프라이버시",
    "fsevent": "파일 흔적"
  },
  "rules": [
    {
      "id": "login",
      "name": "로그인",
      "category": "account",
      "evidence_level": "direct",
      "summary": "config.json에 계정 UUID와 조직 UUID가 평문으로 기록됨",
      "require": [
        {
          "kind": "account",
          "source": "config",
          "value_has": "account_uuid"
        }
      ],
      "time_from": "account",
      "explain": "로그인하면 앱이 계정·조직 식별자를 config.json에 남긴다. 이 값이 있다는 것 자체가 로그인 이력의 직접 증거다."
    },
    {
      "id": "account_switch",
      "name": "계정 전환",
      "category": "account",
      "evidence_level": "direct",
      "summary": "서로 다른 조직 UUID가 둘 이상 병존",
      "require": [
        {
          "kind": "account",
          "source": "config"
        },
        {
          "kind": "blob_uuids",
          "min_count": 2
        }
      ],
      "distinct_uuids_min": 2,
      "time_from": "account",
      "explain": "계정을 바꿔도 이전 계정의 마커가 지워지지 않는다. 한 PC에서 여러 조직 UUID가 보이면 계정 전환을 의심한다."
    },
    {
      "id": "app_uninstalled",
      "name": "애플리케이션 삭제",
      "category": "install",
      "evidence_level": "direct",
      "summary": "앱 루트 하위 엔트리가 전부 삭제 표시",
      "require": [
        {
          "kind": "app_removed",
          "source": "fsmeta"
        }
      ],
      "per_record": true,
      "time_from": "context",
      "explain": "앱을 제거해도 $MFT 엔트리는 남는다. 그래서 '무엇이 있었는지'는 복원된다. 다만 클러스터가 재할당된 파일은 본문이 남의 데이터로 바뀌므로 메타데이터만 복구로 표기한다."
    },
    {
      "id": "conversation_create",
      "name": "새로운 대화 생성",
      "category": "conv",
      "evidence_level": "direct",
      "summary": "대화 응답 본문이 캐시에 저장됨",
      "require": [
        {
          "kind": "conversation",
          "source": "cache"
        }
      ],
      "per_record": true,
      "time_from": "self",
      "explain": "대화가 만들어지면 서버 응답이 HTTP 캐시에 그대로 떨어진다. 대화 UUID·제목·모델명이 여기서 나온다."
    },
    {
      "id": "conversation_open",
      "name": "대화 열람",
      "category": "conv",
      "evidence_level": "direct",
      "summary": "IndexedDB에 대화 열람 시각(lastOpenedAt)이 기록됨",
      "require": [
        {
          "kind": "conversation_opened"
        }
      ],
      "per_record": true,
      "time_from": "self",
      "explain": "claude-conversation-store/meta 에 대화를 연 시각이 앱 자체 시각으로 남는다. 파일 시각과 달리 종료 flush의 영향을 받지 않아 신뢰도가 높고, 같은 대화가 여러 번 열린 이력도 각각 남는다. 구조 파싱이 실패해도 원시 스캔에서 lastOpenedAt 을 건지면 같은 판정을 낸다."
    },
    {
      "id": "conversation_delete",
      "name": "기존 대화 삭제",
      "category": "conv",
      "evidence_level": "supporting",
      "summary": "대화 마커는 남아 있으나 목록에서 사라진 흔적",
      "require": [
        {
          "kind": "conversation_marker",
          "min_count": 1
        },
        {
          "kind": "conversation",
          "source": "cache",
          "absent": true
        }
      ],
      "time_from": "conversation_marker",
      "explain": "삭제해도 캐시 본문과 IndexedDB 마커는 남는다. 목록에는 없는데 마커만 남아 있으면 삭제를 의심한다. 단독으로는 단정하지 못해 보조 증거로 둔다."
    },
    {
      "id": "prompt_draft",
      "name": "사용자 프롬프트 입력/전송",
      "category": "prompt",
      "evidence_level": "supporting",
      "summary": "입력 초안 키가 UTF-16LE로 검출됨",
      "require": [
        {
          "kind": "draft_marker",
          "min_count": 1
        }
      ],
      "per_record": false,
      "time_from": "draft_marker",
      "explain": "chorus-unified-composer / store:chat-draft 키가 IndexedDB에 UTF-16LE로만 남는다. UTF-8 단독 검색으로는 검출되지 않는다. 키 존재는 입력이 있었음을 뒷받침하지만 본문은 별도 채널에서 확인해야 한다."
    },
    {
      "id": "prompt_sent",
      "name": "사용자 프롬프트 입력/전송",
      "category": "prompt",
      "evidence_level": "direct",
      "summary": "대화 응답에 사용자 메시지 전문이 포함됨",
      "require": [
        {
          "kind": "message",
          "source": "cache",
          "value_eq": {
            "sender": "human"
          }
        }
      ],
      "per_record": true,
      "time_from": "self",
      "explain": "서버 응답에 사용자가 보낸 원문이 그대로 들어 있다. 시각은 API의 created_at을 쓰므로 파일 시각보다 신뢰도가 높다."
    },
    {
      "id": "model_response",
      "name": "모델 응답 수신",
      "category": "prompt",
      "evidence_level": "direct",
      "summary": "대화 응답에 모델 답변 전문이 포함됨",
      "require": [
        {
          "kind": "message",
          "source": "cache",
          "value_eq": {
            "sender": "assistant"
          }
        }
      ],
      "per_record": true,
      "time_from": "self",
      "explain": "질문과 답변이 쌍으로 남아 대화 맥락 전체를 복원할 수 있다."
    },
    {
      "id": "file_upload",
      "name": "파일 업로드",
      "category": "file",
      "evidence_level": "supporting",
      "summary": "첨부 마커 검출 및 Blob 실물 존재",
      "require": [
        {
          "kind": "attachment_marker",
          "min_count": 1
        }
      ],
      "time_from": "attachment_marker",
      "explain": "첨부 관련 키가 IndexedDB에 남고 실물은 blob 폴더에 저장된다. 이미지인지 문서인지는 마커만으로 구별되지 않아 보조 증거로 둔다."
    },
    {
      "id": "app_launch",
      "name": "애플리케이션 실행",
      "category": "runtime",
      "evidence_level": "supporting",
      "summary": "앱 로그에 기동 기록",
      "require": [
        {
          "kind": "appevent",
          "source": "applog"
        }
      ],
      "time_from": "appevent",
      "explain": "앱이 직접 찍은 로그라 시각 신뢰도가 높다. 패키지 밖에 있어 앱을 제거해도 남는다."
    },
    {
      "id": "app_exit_clean",
      "name": "정상 종료",
      "category": "runtime",
      "evidence_level": "direct",
      "summary": "종료 직전 config.json 재작성 + window-state 갱신",
      "require": [
        {
          "kind": "account",
          "source": "config"
        },
        {
          "kind": "window_state",
          "source": "config"
        }
      ],
      "time_from": "window_state",
      "explain": "정상 종료는 끝나기 0.5초 전에 config.json을 원자적으로 다시 쓰고 창 상태를 저장한다. 강제 종료면 이 두 가지가 일어나지 않는다 — 이 차이가 정상/강제 종료를 가른다."
    },
    {
      "id": "model_change",
      "name": "모델 변경",
      "category": "settings",
      "evidence_level": "supporting",
      "summary": "analytics_queue에 모델 선택 이벤트",
      "require": [
        {
          "kind": "model_change",
          "min_count": 1
        }
      ],
      "time_from": "model_change",
      "explain": "데스크톱은 상태값만 남아 변경 시점 특정이 어렵다. 웹 트랙이 이 행위에서는 더 우세하다."
    },
    {
      "id": "account_rename",
      "name": "계정 이름 변경",
      "category": "settings",
      "evidence_level": "supporting",
      "summary": "Blob에 계정 프로필 평문 존재",
      "require": [
        {
          "kind": "account_profile",
          "source": "blob"
        }
      ],
      "per_record": true,
      "time_from": "context",
      "explain": "표시 이름·이메일이 Blob에 평문으로 남는다. 변경 전후 값이 함께 나오면 변경 시점을 좁힐 수 있다."
    },
    {
      "id": "temporary_chat",
      "name": "임시 채팅 사용",
      "category": "privacy",
      "evidence_level": "supporting",
      "summary": "is_temporary 플래그 검출",
      "require": [
        {
          "kind": "temp_chat",
          "min_count": 1
        }
      ],
      "time_from": "temp_chat",
      "conflict_note": "임시 채팅의 로컬 잔존 여부는 관측 회차에 따라 결과가 엇갈린다. 단정하지 않고 상충 사실을 함께 표기한다.",
      "explain": "임시 채팅이라도 응답이 캐시에 남는 관측이 있었다. 다만 회차별로 결과가 달라 보조 증거로만 쓴다."
    },
    {
      "id": "cache_cleared",
      "name": "캐시 삭제",
      "category": "privacy",
      "evidence_level": "supporting",
      "summary": "캐시 파일 번호가 리셋된 흔적",
      "require": [
        {
          "kind": "time_warning",
          "source": "fsmeta",
          "absent": true
        },
        {
          "kind": "fileinfo",
          "source": "fsmeta",
          "max_count": 5
        }
      ],
      "time_from": "fileinfo",
      "explain": "캐시를 지우면 f_* 번호가 처음부터 다시 매겨진다. IndexedDB와 Local Storage는 지워지지 않으므로 대화 목록은 그대로 남는다."
    },
    {
      "id": "conversation_delete_cache",
      "name": "기존 대화 삭제",
      "category": "conv",
      "evidence_level": "supporting",
      "summary": "캐시 엔트리가 삭제되어 본문 복원 불가",
      "require": [
        {
          "kind": "deleted_cache_entry",
          "source": "cache"
        }
      ],
      "per_record": false,
      "time_from": "context",
      "explain": "삭제된 캐시 엔트리가 다수 남아 있다. 클러스터 재할당으로 본문은 소실됐지만 '그 자리에 캐시가 있었다'는 사실은 확인된다."
    },
    {
      "id": "fs_file_deleted",
      "name": "파일 삭제 기록",
      "category": "fsevent",
      "evidence_level": "direct",
      "summary": "변경 저널에 Claude 관련 파일의 삭제가 기록됨",
      "require": [
        {
          "kind": "usn_delete",
          "source": "usnjrnl"
        }
      ],
      "per_record": true,
      "time_from": "self",
      "explain": "$UsnJrnl:$J 는 파일이 지워진 사실과 시각을 남긴다. 파일이 사라진 뒤에도 무엇이 언제 사라졌는지 알 수 있다."
    },
    {
      "id": "fs_file_renamed",
      "name": "파일 이동·이름 변경",
      "category": "fsevent",
      "evidence_level": "supporting",
      "summary": "변경 저널에 Claude 관련 파일의 이름 변경이 기록됨",
      "require": [
        {
          "kind": "usn_rename",
          "source": "usnjrnl"
        }
      ],
      "per_record": true,
      "time_from": "self",
      "explain": "이름 변경은 이전 이름과 새 이름이 각각 기록된다. 둘을 이어 붙이면 파일의 이동 경로가 보인다."
    },
    {
      "id": "fs_recycle_deleted",
      "name": "휴지통 삭제",
      "category": "fsevent",
      "evidence_level": "direct",
      "summary": "$Recycle.Bin 에 원래 경로와 삭제 시각이 남음",
      "require": [
        {
          "kind": "recycle_entry",
          "source": "recyclebin",
          "value_eq": {
            "claude_related": true
          }
        }
      ],
      "per_record": true,
      "time_from": "self",
      "explain": "$I 파일에는 지워진 파일의 원래 전체 경로와 삭제 시각이 그대로 들어 있다."
    },
    {
      "id": "fs_file_created",
      "name": "파일 생성 기록",
      "category": "fsevent",
      "evidence_level": "supporting",
      "summary": "변경 저널에 Claude 관련 파일의 생성이 기록됨",
      "require": [
        {
          "kind": "usn_create",
          "source": "usnjrnl"
        }
      ],
      "per_record": true,
      "time_from": "self",
      "explain": "설치 파일과 업로드 파일이 언제 만들어졌는지는 행위 시점을 잡는 근거다."
    },
    {
      "id": "fs_file_modified",
      "name": "파일 변경 기록",
      "category": "fsevent",
      "evidence_level": "supporting",
      "summary": "변경 저널에 Claude 관련 파일의 내용 변경이 기록됨",
      "require": [
        {
          "kind": "usn_event",
          "source": "usnjrnl"
        }
      ],
      "per_record": true,
      "time_from": "self",
      "explain": "덮어쓰기·추가 기록은 앱이 실제로 쓰이고 있었다는 보조 근거다."
    },
    {
      "id": "login_log",
      "name": "로그인",
      "category": "account",
      "evidence_level": "direct",
      "summary": "앱 로그에 로그인 상태 전이",
      "require": [
        {
          "kind": "log_login",
          "source": "applog"
        }
      ],
      "per_record": true,
      "time_from": "log_login",
      "explain": "로그인 상태가 바뀐 줄이다. 계정 UUID가 함께 적혀 있어 누가 로그인했는지까지 알 수 있다."
    },
    {
      "id": "logout_log",
      "name": "로그아웃",
      "category": "account",
      "evidence_level": "direct",
      "summary": "앱 로그에 로그아웃 기록",
      "require": [
        {
          "kind": "log_logout",
          "source": "applog"
        }
      ],
      "per_record": true,
      "time_from": "log_logout",
      "explain": "세션이 끊긴 시각의 근거다."
    },
    {
      "id": "account_log",
      "name": "로그인",
      "category": "account",
      "evidence_level": "supporting",
      "summary": "앱 로그에 계정 식별자",
      "require": [
        {
          "kind": "log_account",
          "source": "applog",
          "value_has": "account_uuid"
        }
      ],
      "time_from": "log_account",
      "explain": "로그에 찍힌 계정 UUID다. 어느 계정이 이 PC를 썼는지의 근거. 사용자 행위가 아닌 증거라 행위명은 로그인(의심)으로 두고 식별자는 상세에 남긴다 (팀 합의 2026-09-23).",
      "per_record": true
    },
    {
      "id": "org_log",
      "name": "로그인",
      "category": "account",
      "evidence_level": "supporting",
      "summary": "앱 로그에 조직 식별자",
      "require": [
        {
          "kind": "log_org",
          "source": "applog",
          "value_has": "org_uuid"
        }
      ],
      "time_from": "log_org",
      "explain": "계정이 속한 조직 UUID다. 계정 식별자와 같은 이유로 행위명은 로그인(의심).",
      "per_record": true
    },
    {
      "id": "app_exit_log",
      "name": "정상 종료",
      "category": "runtime",
      "evidence_level": "supporting",
      "summary": "앱 로그에 종료 기록",
      "require": [
        {
          "kind": "log_quit",
          "source": "applog"
        }
      ],
      "per_record": true,
      "time_from": "log_quit",
